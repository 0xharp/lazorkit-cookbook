{
  "expo": {
    "name": "LazorKit Cookbook",
    "slug": "lazorkit-cookbook-mobile",
    "privacy": "public",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/LazorKitLogoLight.png",
    "scheme": "lazorkitcookbook",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/LazorKitLogoLight.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lazorkit.cookbook",
      "splash": {
        "image": "./assets/LazorKitLogoLight.png",
        "resizeMode": "contain",
        "backgroundColor": "#1a1a2e"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/LazorKitLogoLight.png",
        "backgroundColor": "#1a1a2e"
      },
      "splash": {
        "image": "./assets/LazorKitLogoLight.png",
        "resizeMode": "contain",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.lazorkit.cookbook"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.ico"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "229c9ca8-de3e-495c-ae90-ddc19d189aab"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/229c9ca8-de3e-495c-ae90-ddc19d189aab"
    }
  }
}
